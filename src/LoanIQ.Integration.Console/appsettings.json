{
  "ConsoleSettings": {
    "MonitoredDirectory": "data/incoming",
    "ProcessedDirectory": "data/processed"
  },
  "GlExtractSettings": {
    "InputDirectory": "data/gl-extract/incoming",
    "ProcessedDirectory": "data/gl-extract/processed",
    "OutputDirectory": "data/gl-extract/output",
    "Branches": []
  },
  "PaymentExtractSettings": {
    "InputDirectory": "data/payment-extract/incoming",
    "ProcessedDirectory": "data/payment-extract/processed",
    "OutputDirectory": "data/payment-extract/output"
  },
  "AuditSettings": {
    "ConnectionString": "",
    "QueueName": "customer-audit"
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.Hosting.Lifetime": "Information",
        "System": "Warning"
      }
    },
    "WriteTo": [
      { "Name": "Console" },
      {
        "Name": "File",
        "Args": {
          "path": "logs/loaniq-integration-console-.log",
          "rollingInterval": "Day"
        }
      }
    ]
  }
}
